# Postgres (metadata + vector store)
POSTGRES_USER=myai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myai
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-long-random-string
BACKEND_PORT=8000

# Embedding service (default: local text-embeddings-inference container running bge-m3)
EMBEDDING_PORT=8081

# Frontend
FRONTEND_PORT=3000
